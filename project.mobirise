    "index.html": {
      "settings": {
        "main": true,
        "title": "How Acting and Design Share the Same Soul ｜ Eddiepan",
        "meta_descr": "Acting and design may seem worlds apart — one tells stories through emotions, the other through visuals.\n Yet both share a creative heartbeat: empathy, discipline, and the pursuit of meaning.",
        "header_custom": "",
        "footer_custom": "",
